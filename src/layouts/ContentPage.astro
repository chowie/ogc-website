---
// An inner page whose copy comes from the pages collection: header band,
// the section's links on the side, then the Markdown. Pages that need more
// (a map, a list) pass it in the default slot, shown after the copy, or the
// "before" slot, shown before it. A `form:` in the frontmatter is shown right
// after the copy.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from './Base.astro';
import PageHead from '../components/PageHead.astro';
import NetlifyForm from '../components/NetlifyForm.astro';
import { sectionFor, isCurrentPage, normalizePath } from '../data/nav';
import { hasLeadCopy } from '../lib/section-status.mjs';

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, eyebrow, intro, description, origin, sections, form } = entry.data;

const path = normalizePath(Astro.url.pathname);
const section = sectionFor(path);
const onThisPage = section?.children.every((c) => c.href.includes('#'));
// Sections carry their own badge and note. The page's own `origin` covers the
// intro and any text before the first section, so show it when there is some.
const showPageOrigin = hasLeadCopy(entry.body, intro) || (!headings.some((h) => h.depth === 2) && !Object.keys(sections).length);
---

<Base title={title} description={description ?? intro}>
  <PageHead title={title} eyebrow={eyebrow ?? (section && section.href !== path ? section.label : undefined)} intro={intro} origin={showPageOrigin ? origin : undefined} />
  <div class="section">
    <div class:list={['container', { 'content-layout': section }]}>
      {section && (
        <nav class="content-layout__nav subnav" aria-label={onThisPage ? 'On this page' : `In ${section.label}`}>
          <p>{onThisPage ? 'On this page' : section.label}</p>
          {!onThisPage && <a href={section.href} aria-current={path === section.href ? 'page' : undefined}>Overview</a>}
          {section.children.map((c) => (
            <a href={c.href} aria-current={isCurrentPage(c, path) ? 'page' : undefined}>{c.label}</a>
          ))}
        </nav>
      )}
      <div>
        <slot name="before" />
        <div class="prose"><Content /></div>
        {form && <NetlifyForm name={form.name} interest={form.interest} />}
        <slot />
      </div>
    </div>
  </div>
</Base>
