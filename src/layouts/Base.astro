---
import '@fontsource-variable/unbounded';
import '../styles/global.css';
import { site, allowIndexing, telHref } from '../lib/site';
import { nav, sectionFor, isCurrentPage, normalizePath } from '../data/nav';

interface Props {
  title?: string;
  description?: string;
  /** Keep this page out of search engines even after go-live. */
  noindex?: boolean;
}

const { title, description = site.tagline, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;

const path = normalizePath(Astro.url.pathname);
const current = sectionFor(path);
const firstMinor = nav.find((item) => item.minor);
const { address } = site;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {(!allowIndexing || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="wordmark" href="/">
          {site.name.split(' ').map((word) => <span>{word}</span>)}
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="nav-toggle__bars" aria-hidden="true"></span>
          <span class="visually-hidden">Menu</span>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Main">
          <ul class="site-nav__list">
            {nav.map((item, i) => (
              <li class:list={['site-nav__item', { 'is-minor': item.minor, 'is-cta': item.cta, 'is-first-minor': item === firstMinor }]}>
                <div class="site-nav__top">
                  <a class="site-nav__link" href={item.href} aria-current={path === item.href ? 'page' : current === item ? 'true' : undefined}>{item.label}</a>
                  <button class="site-nav__more" type="button" aria-expanded="false" aria-controls={`site-nav-sub-${i}`}>
                    <span class="visually-hidden">{item.label} pages</span>
                  </button>
                </div>
                <ul class="site-nav__sub" id={`site-nav-sub-${i}`}>
                  {item.children.map((child) => (
                    <li><a href={child.href} aria-current={isCurrentPage(child, path) ? 'page' : undefined}>{child.label}</a></li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__grid">
        <div>
          <p class="wordmark wordmark--footer">
            {site.name.split(' ').map((word) => <span>{word}</span>)}
          </p>
          <ul class="list-plain site-footer__times">
            {site.serviceTimes.map((s) => <li>{s.label}: {s.day}s, {s.time}</li>)}
          </ul>
          <a class="btn btn--light site-footer__cta" href="/plan-your-visit">Plan Your Visit</a>
        </div>
        <div>
          <h2 class="site-footer__heading">Visit</h2>
          <address>
            {address.street}<br />
            {address.city}, {address.state} {address.zip}
          </address>
          {site.phone && <p><a href={telHref}>{site.phone}</a></p>}
          {site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
        </div>
        <div>
          <h2 class="site-footer__heading">Explore</h2>
          <ul class="list-plain">
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="site-footer__heading">Connect</h2>
          <ul class="list-plain">
            <li><a href="/contact#prayer-request">Send a prayer request</a></li>
            {site.social.map((s) => <li><a href={s.url}>{s.label}</a></li>)}
          </ul>
        </div>
      </div>
      <div class="container site-footer__base">
        <p>© {new Date().getFullYear()} {site.name}</p>
        <p>Privacy and photo/video policy: <span class="status-badge status-badge--placeholder">Placeholder</span></p>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const navEl = document.getElementById('site-nav');
      const desktop = window.matchMedia('(min-width: 78rem)');
      const items = [...document.querySelectorAll<HTMLLIElement>('.site-nav__item')];

      const setOpen = (item: HTMLLIElement, open: boolean) => {
        item.classList.toggle('is-open', open);
        item.querySelector('.site-nav__more')?.setAttribute('aria-expanded', String(open));
      };
      const closeAll = (except?: HTMLLIElement) => items.forEach((i) => i !== except && setOpen(i, false));
      const setPanel = (open: boolean) => {
        toggle?.setAttribute('aria-expanded', String(open));
        navEl?.classList.toggle('is-open', open);
      };

      toggle?.addEventListener('click', () => setPanel(toggle.getAttribute('aria-expanded') !== 'true'));

      for (const item of items) {
        item.querySelector('.site-nav__more')?.addEventListener('click', () => {
          const open = !item.classList.contains('is-open');
          closeAll(item);
          setOpen(item, open);
        });
        // Desktop dropdowns close when focus moves elsewhere.
        item.addEventListener('focusout', (e) => {
          if (desktop.matches && !item.contains(e.relatedTarget as Node | null)) setOpen(item, false);
        });
      }

      document.addEventListener('click', (e) => {
        if (desktop.matches && !navEl?.contains(e.target as Node)) closeAll();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const open = items.find((i) => i.classList.contains('is-open'));
        if (open) {
          setOpen(open, false);
          open.querySelector<HTMLButtonElement>('.site-nav__more')?.focus();
        } else if (toggle?.getAttribute('aria-expanded') === 'true') {
          setPanel(false);
          toggle.focus();
        }
      });

      desktop.addEventListener('change', () => {
        closeAll();
        setPanel(false);
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--slate) 94%, transparent);
    backdrop-filter: blur(6px);
    color: #fff;
  }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-m); min-height: 4.5rem; }

  .wordmark {
    display: grid; font-family: var(--font-display); font-weight: 700;
    font-size: 0.7rem; line-height: 1.25; letter-spacing: 0.3em; text-transform: uppercase;
    color: #fff; text-decoration: none; margin: 0;
  }
  .wordmark span:last-child::before { content: ''; display: inline-block; width: 1.2em; height: 2px; background: var(--coral); vertical-align: middle; margin-right: 0.4em; }
  .wordmark--footer { font-size: 0.8rem; }

  .nav-toggle {
    display: none; background: none; border: 0; color: #fff; padding: 0.75rem; cursor: pointer;
  }
  .nav-toggle__bars, .nav-toggle__bars::before, .nav-toggle__bars::after {
    display: block; width: 1.6rem; height: 2px; background: currentColor; position: relative; transition: transform 0.2s;
  }
  .nav-toggle__bars::before, .nav-toggle__bars::after { content: ''; position: absolute; left: 0; }
  .nav-toggle__bars::before { top: -7px; }
  .nav-toggle__bars::after { top: 7px; }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars { background: transparent; }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars::before { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars::after { transform: translateY(-7px) rotate(-45deg); }

  /* Menu. Desktop (78rem+): a bar with dropdowns. Smaller: a panel behind the
     toggle, with each section as an accordion. Without JS, dropdowns open on
     hover/focus (desktop) and every link is listed (smaller screens). */
  .site-nav__list, .site-nav__sub { list-style: none; margin: 0; padding: 0; }
  .site-nav__top { display: flex; align-items: center; }
  .site-nav a { color: #fff; text-decoration: none; }
  .site-nav__link { font-weight: 600; font-size: 0.95rem; padding-block: 0.4rem; border-bottom: 2px solid transparent; white-space: nowrap; }
  .site-nav__link:hover, .site-nav__link[aria-current] { border-bottom-color: var(--coral); }
  .site-nav__more {
    background: none; border: 0; color: inherit; cursor: pointer;
    padding: 0.5rem 0.4rem; display: inline-flex; align-items: center;
  }
  .site-nav__more::before {
    content: ''; width: 0.45em; height: 0.45em; border: solid currentColor; border-width: 0 2px 2px 0;
    transform: translateY(-25%) rotate(45deg); transition: transform 0.15s;
  }
  .site-nav__item.is-open > .site-nav__top .site-nav__more::before { transform: translateY(25%) rotate(-135deg); }
  :global(html:not(.js)) .site-nav__more { display: none; }
  .site-nav__sub a { display: block; padding: 0.55rem 1rem; font-size: 0.95rem; }
  .site-nav__sub a:hover, .site-nav__sub a[aria-current] { background: rgb(255 255 255 / 0.1); }
  .site-nav__sub a[aria-current] { box-shadow: inset 3px 0 0 var(--coral); }
  .is-minor .site-nav__link { font-size: 0.85rem; font-weight: 500; }
  .is-cta .site-nav__top { background: var(--coral); color: var(--ink); }
  .is-cta .site-nav__link {
    color: var(--ink); border: 0; padding: 0.55rem 0.25rem 0.55rem 1rem;
    font-family: var(--font-display); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase;
  }
  .is-cta .site-nav__more { padding-right: 0.75rem; }
  .is-cta .site-nav__top:hover { background: #fff; }

  @media (min-width: 78rem) {
    .site-nav__list { display: flex; align-items: center; gap: var(--space-s); }
    .site-nav__item { position: relative; }
    .is-first-minor { margin-left: var(--space-m); }
    .site-nav__sub {
      display: none; position: absolute; top: 100%; left: 0; min-width: 15rem; z-index: 60;
      background: var(--slate-dark); padding: var(--space-xs) 0; box-shadow: 0 10px 24px rgb(0 0 0 / 0.25);
    }
    .is-cta .site-nav__sub, .is-minor .site-nav__sub { left: auto; right: 0; }
    .site-nav__item.is-open .site-nav__sub { display: block; }
    :global(html:not(.js)) .site-nav__item:hover .site-nav__sub,
    :global(html:not(.js)) .site-nav__item:focus-within .site-nav__sub { display: block; }
  }

  @media (max-width: 77.99rem) {
    .site-header__inner { flex-wrap: wrap; }
    .site-nav { flex-basis: 100%; padding-bottom: var(--space-s); }
    .site-nav__sub a { padding-left: var(--space-m); color: var(--on-dark-muted); }
    :global(.js) .nav-toggle { display: block; }
    :global(.js) .site-header__inner { flex-wrap: nowrap; }
    :global(.js) .site-nav {
      display: none; position: absolute; inset: 100% 0 auto; background: var(--slate);
      padding: var(--space-xs) var(--gutter) var(--space-m); max-height: calc(100dvh - 4.5rem); overflow-y: auto;
    }
    :global(.js) .site-nav.is-open { display: block; }
    .site-nav__top { justify-content: space-between; border-bottom: 1px solid rgb(255 255 255 / 0.12); }
    .site-nav__link { flex: 1; padding: 0.85rem 0; border: 0; }
    .site-nav__more { padding: 0.85rem 0.75rem; }
    :global(.js) .site-nav__sub { display: none; }
    :global(.js) .site-nav__item.is-open .site-nav__sub { display: block; }
    .is-cta { margin-top: var(--space-s); }
    .is-cta .site-nav__top { border: 0; }
  }

  .site-footer { background: var(--slate-dark); color: var(--on-dark-muted); padding-block: var(--space-l) var(--space-m); font-size: 0.95rem; }
  .site-footer a { color: #fff; }
  .site-footer address { font-style: normal; margin-bottom: var(--space-s); }
  .site-footer__grid { display: grid; gap: var(--space-m); grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); }
  .site-footer__heading { font-size: 0.75rem; letter-spacing: 0.2em; color: #fff; margin-bottom: var(--space-xs); }
  .site-footer__base { border-top: 1px solid rgb(255 255 255 / 0.12); margin-top: var(--space-l); padding-top: var(--space-s); font-size: var(--step--1); }
  .site-footer__base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-xs) var(--space-m); }
  .site-footer__base p { margin: 0; }
  .site-footer__times { margin-block: var(--space-s); }
  .site-footer__cta { margin-top: var(--space-xs); }
</style>
