---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props =
  | {
      member: CollectionEntry<'team'>;
      width: number;
      /** Set for above-the-fold photos (profile pages). */
      eager?: boolean;
    }
  /** An empty frame for a proposed position nobody holds yet. */
  | { proposed: true };
const props = Astro.props;
const member = 'member' in props ? props : undefined;
const { photo, photoAlt, name } = member?.member.data ?? { name: '' };
const initials = name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('');
---

{member && photo ? (
  <Image class="team-photo" src={photo} alt={photoAlt ?? name} width={member.width} loading={member.eager ? 'eager' : 'lazy'} fetchpriority={member.eager ? 'high' : undefined} />
) : (
  <div class:list={['team-photo team-photo--empty', { 'team-photo--proposed': !member }]} aria-hidden="true">
    <span>{initials}</span>
    <span class="team-photo__note">{member ? 'Photo to come' : 'Proposed'}</span>
  </div>
)}

<style>
  .team-photo { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; background: var(--mist); }
  .team-photo--empty {
    display: grid; place-items: center;
    background: linear-gradient(135deg, var(--slate), var(--plum));
    color: #fff; font-family: var(--font-display); font-weight: 700; font-size: var(--step-3); letter-spacing: 0.05em;
    grid-template-rows: 1fr auto; padding-bottom: 1em;
  }
  .team-photo--empty > :first-child { align-self: center; }
  .team-photo__note { text-align: center; padding-inline: 0.5em; font-family: var(--font-body); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.8; }
  /* Phone team cards show a small photo column; initials alone fit there. A
     proposed frame has no initials, so it keeps its note. */
  @media (max-width: 29.99rem) { :global(.team-card) .team-photo:not(.team-photo--proposed) .team-photo__note { display: none; } }
</style>
