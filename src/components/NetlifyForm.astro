---
// One of the forms in src/data/forms.ts, posted to Netlify Forms (detected at
// deploy time via data-netlify) with a honeypot, then on to /thanks.
// `interest` preselects an option of the connect form's "interest" list.
import { forms, type FormDef, type FormName } from '../data/forms';
import { nextSunday } from '../lib/time';

interface Props {
  name: FormName;
  interest?: string;
}
const { name, interest } = Astro.props;
const form: FormDef = forms[name];
const select = form.fields.find((f) => f.type === 'select');
if (interest && !select?.options?.includes(interest)) {
  throw new Error(`Form "${name}": interest "${interest}" isn't one of its options (src/data/forms.ts).`);
}
// Ids are prefixed with the form name so two forms can share a page.
const id = (field: string) => `${name}-form-${field}`;
// Sundays only: the browser accepts the coming Sunday and every 7 days after.
// The daily rebuild moves `min` forward.
const sunday = nextSunday();
---

<form class="site-form" name={name} method="POST" action="/thanks" data-netlify="true" netlify-honeypot="bot-field">
  <input type="hidden" name="form-name" value={name} />
  <p hidden><label>Leave blank <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
  {form.fields.map((f) => (
    <div class="field">
      <label for={id(f.name)}>{f.label}</label>
      {f.type === 'textarea' ? (
        <textarea id={id(f.name)} name={f.name} rows="4" required={f.required}></textarea>
      ) : f.type === 'select' ? (
        <select id={id(f.name)} name={f.name} required={f.required}>
          {f.options?.map((o) => <option selected={o === interest}>{o}</option>)}
        </select>
      ) : (
        <input id={id(f.name)} name={f.name} type={f.type ?? 'text'} autocomplete={f.autocomplete} required={f.required} min={f.sundays ? sunday : undefined} step={f.sundays ? 7 : undefined} />
      )}
    </div>
  ))}
  <p class="demo-notice">Demo site: this form isn't monitored yet. To reach someone, call the church office.</p>
  <button class="btn btn--solid" type="submit">{form.submit}</button>
</form>

<style>
  .site-form { margin-top: var(--space-s); max-width: 36rem; }
</style>
