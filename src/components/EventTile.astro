---
import type { CollectionEntry } from 'astro:content';
import { TZ as tz } from '../lib/time';
import ShareButton from './ShareButton.astro';
import { eventWhen } from '../lib/content';
import { googleCalendarUrl, toCalendarEvent } from '../lib/calendar';

interface Props {
  event: CollectionEntry<'events'>;
}
const { event } = Astro.props;
const { title, start, location, repeat } = event.data;
const month = start.toLocaleDateString('en-US', { month: 'short', timeZone: tz });
const day = start.toLocaleDateString('en-US', { day: 'numeric', timeZone: tz });
const { when, times } = eventWhen(event.data);
const google = googleCalendarUrl(toCalendarEvent(event.id, event.data, Astro.site!));
---

<article class="event-tile">
  <p class="event-tile__date">
    <time datetime={start.toISOString()}>
      <span class="event-tile__month">{month}</span>
      <span class="event-tile__day">{day}</span>
    </time>
  </p>
  <h3 class="event-tile__title"><a href={`/events/${event.id}`}>{title}</a></h3>
  <p class="event-tile__meta">{repeat === 'weekly' ? when : times}{location && ` · ${location}`}</p>
  <div class="event-tile__actions">
    <ShareButton url={`/events/${event.id}`} title={title} light />
    <span class="add-cal">
      Add to Calendar:
      <a href={`/events/${event.id}.ics`} download>Apple / Outlook<span class="visually-hidden">: {title}</span></a>
      <a href={google} target="_blank" rel="noopener">Google<span class="visually-hidden">: {title}</span></a>
    </span>
  </div>
</article>

<style>
  .event-tile { background: rgb(255 255 255 / 0.06); border-top: 4px solid var(--coral); padding: var(--space-m); height: 100%; }
  .event-tile__date { margin: 0 0 var(--space-s); font-family: var(--font-display); text-transform: uppercase; line-height: 1; }
  .event-tile__date time { display: flex; align-items: baseline; gap: 0.5rem; }
  .event-tile__month { font-size: var(--step-2); font-weight: 700; color: #fff; }
  .event-tile__day { font-size: var(--step-1); color: var(--coral-light); }
  .event-tile__title { font-family: var(--font-body); text-transform: none; letter-spacing: 0; font-size: var(--step-1); margin-bottom: var(--space-xs); }
  .event-tile__meta { color: var(--on-dark-muted); font-size: 0.95rem; margin: 0 0 var(--space-s); }
  .event-tile__title a { color: #fff; }
  .event-tile__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-m); }
  .add-cal { display: inline-flex; flex-wrap: wrap; gap: 0.75em; font-size: var(--step--1); color: var(--on-dark-muted); }
  .add-cal a { color: #fff; }
</style>
