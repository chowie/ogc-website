---
// A section heading for .astro pages, matching what section-status gives
// Markdown sections: an id the menu can link to, plus the demo badge and
// source note. Every such section needs its own entry in the page's
// frontmatter `sections:`, so /content-status lists it too; the build stops
// if one is missing.
import type { CollectionEntry } from 'astro:content';
import { slugify } from '../lib/section-status.mjs';
import SectionMeta from './SectionMeta.astro';

interface Props {
  title: string;
  entry: CollectionEntry<'pages'>;
  level?: 2 | 3;
}
const { title, entry, level = 2 } = Astro.props;
const id = slugify(title);
const origin = entry.data.sections[id];
if (!origin) {
  throw new Error(`src/content/pages/${entry.id}.md: add "${id}" under sections: (status, from, on, note) for the "${title}" section.`);
}
const Tag = (level === 3 ? 'h3' : 'h2') as 'h2' | 'h3';
---

<Tag id={id}>{title}</Tag>
<SectionMeta origin={origin} label={title} />
