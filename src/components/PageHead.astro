---
import SectionMeta from './SectionMeta.astro';

interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
  /** Demo: badge and source note for a page that has no sections to carry them. */
  origin?: { status: string; from?: string; on?: Date; note?: string };
}
const { title, eyebrow, intro, origin } = Astro.props;
---

<header class="page-head">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {origin && <SectionMeta origin={origin} />}
    {intro && <p>{intro}</p>}
  </div>
</header>
