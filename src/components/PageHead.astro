---
import type { CollectionEntry } from 'astro:content';
import SectionMeta from './SectionMeta.astro';

interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
  /** Demo: badge and source note for the page's intro and opening text. */
  origin?: CollectionEntry<'pages'>['data']['origin'];
}
const { title, eyebrow, intro, origin } = Astro.props;
---

<header class="page-head">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {origin && <SectionMeta origin={origin} label={title} />}
    {intro && <p>{intro}</p>}
  </div>
</header>
