---
interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
}
const { title, eyebrow, intro } = Astro.props;
---

<header class="page-head">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {intro && <p>{intro}</p>}
  </div>
</header>
