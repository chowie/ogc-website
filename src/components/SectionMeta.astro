---
// The line under a section heading: status badge (none for real copy) and a
// collapsed "Source" note. Same markup as sectionMeta() in section-status.mjs,
// which does this for Markdown sections.
import { describeOrigin, STATUS_LABELS } from '../lib/section-status.mjs';

interface Props {
  origin: { status: string; from?: string; on?: Date; note?: string };
}
const { origin } = Astro.props;
const parts = describeOrigin(origin);
---

<div class="section-meta">
  {origin.status !== 'real' && (
    <span class={`status-badge status-badge--${origin.status}`}>{STATUS_LABELS[origin.status as keyof typeof STATUS_LABELS]}</span>
  )}
  <details class="provenance">
    <summary>Source</summary>
    <p>{parts.map((p) => (typeof p === 'string' ? p : <a href={p.href}>{p.text}</a>))}</p>
  </details>
</div>
