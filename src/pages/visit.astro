---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../lib/site';

const { address } = site;
const directionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${site.name}, ${address.street}, ${address.city}, ${address.state} ${address.zip}`,
)}`;
---

<Base title="Plan a Visit">
  <PageHead eyebrow="New Here?" title="Plan a Visit" intro="Come as you are. Here's when and where we meet." />

  <section class="section section--mist">
    <div class="container visit-grid">
      <div>
        <h2>Service Times</h2>
        <ul class="list-plain visit-times">
          {site.serviceTimes.map((s) => <li><strong>{s.label}</strong><br />{s.day} · {s.time}</li>)}
        </ul>
      </div>
      <div>
        <h2>Find Us</h2>
        <address>
          {address.street}<br />
          {address.city}, {address.state} {address.zip}
        </address>
        <p><a href={directionsUrl}>Get directions</a></p>
      </div>
      {(site.phone || site.email) && (
        <div>
          <h2>Call or Email</h2>
          <ul class="list-plain visit-times">
            {site.phone && <li><a href={`tel:+1${site.phone.replace(/\D/g, '')}`}>{site.phone}</a></li>}
            {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
          </ul>
        </div>
      )}
    </div>
  </section>

  {address.mapEmbedUrl && (
    <div class="map">
      <iframe src={address.mapEmbedUrl} title={`Map showing ${site.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  )}

  <section class="section" aria-labelledby="contact-heading">
    <div class="container split">
      <div>
        <h2 id="contact-heading">Contact Us</h2>
        <p class="muted">Questions about visiting, or want someone to look out for you on Sunday? Send us a note.</p>
      </div>
      <!-- Netlify Forms: detected at deploy time via data-netlify. -->
      <form class="contact-form" name="contact" method="POST" action="/thanks" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact" />
        <p hidden><label>Leave blank <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <div class="field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required /></div>
        <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="message">Message</label><textarea id="message" name="message" rows="5" required></textarea></div>
        <button class="btn btn--solid" type="submit">Send Message</button>
      </form>
    </div>
  </section>
</Base>

<style>
  .visit-grid { display: grid; gap: var(--space-l); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .visit-times li { padding-block: var(--space-xs); }
  address { font-style: normal; margin-bottom: var(--space-s); }
  .map iframe { width: 100%; height: clamp(18rem, 40vw, 28rem); border: 0; }
</style>
