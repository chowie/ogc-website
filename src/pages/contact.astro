---
import { getEntry } from 'astro:content';
import ContentPage from '../layouts/ContentPage.astro';
import SectionHeading from '../components/SectionHeading.astro';
import NetlifyForm from '../components/NetlifyForm.astro';
import { site } from '../lib/site';

const entry = (await getEntry('pages', 'contact'))!;
const { address } = site;
---

<ContentPage entry={entry}>
  <div slot="before" class="prose">
    <SectionHeading title="Call, Email or Stop By" entry={entry} />
    <ul class="list-plain contact-list">
      {site.phone && <li><strong>Phone:</strong> <a href={`tel:+1${site.phone.replace(/\D/g, '')}`}>{site.phone}</a></li>}
      {site.email && <li><strong>Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></li>}
      <li><strong>Address:</strong> {address.street}, {address.city}, {address.state} {address.zip}</li>
    </ul>
    <SectionHeading title="Send a Message" entry={entry} />
    <NetlifyForm name="contact" />
  </div>

</ContentPage>

<style>
  .contact-list li { padding-block: 0.25rem; }
</style>
