---
import { getEntry } from 'astro:content';
import ContentPage from '../../layouts/ContentPage.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TeamPhoto from '../../components/TeamPhoto.astro';
import { getTeam, truncate } from '../../lib/content';

const entry = (await getEntry('pages', 'about/team'))!;
const team = await getTeam();
const groups = [
  { key: 'elders', title: 'Pastor and Elders' },
  { key: 'deacons', title: 'Deacons' },
  { key: 'staff', title: 'Staff' },
] as const;
---

<ContentPage entry={entry}>
  {groups.map((g) => {
    const people = team.filter((m) => m.data.group === g.key);
    return (
      <section class="team-group">
        <SectionHeading title={g.title} entry={entry} />
        {people.length > 0 ? (
          <ul class="card-grid team-grid">
            {people.map((m) => (
              <li class="team-card">
                <div class="team-card__photo"><TeamPhoto member={m} width={480} /></div>
                <div class="team-card__body">
                  <h3 class="team-card__name">{m.data.name}</h3>
                  {m.data.role && <p class="team-card__role">{m.data.role}</p>}
                  {m.data.shortBio && <p class="team-card__bio">{truncate(m.data.shortBio)}</p>}
                  <a class="team-card__more" href={`/about/team/${m.id}`}>
                    Read More<span class="visually-hidden"> about {m.data.name}</span>
                  </a>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="team-group__empty">Our deacons care for the practical needs of the church family. Their names, photos and a line about each will go here.</p>
        )}
      </section>
    );
  })}
</ContentPage>

<style>
  .team-group + .team-group { margin-top: var(--space-l); }
  .team-group__empty { color: var(--muted); max-width: 40rem; }
  .team-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }
  .team-card { display: flex; flex-direction: column; background: #fff; box-shadow: 0 1px 0 var(--mist); }
  .team-card__body { padding: var(--space-m); display: flex; flex-direction: column; flex: 1; }
  .team-card__name { font-size: var(--step-1); margin-bottom: 0.25rem; overflow-wrap: normal; }
  .team-card__role { color: var(--coral-ink); font-weight: 600; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .team-card__bio { color: var(--muted); }
  .team-card__more { margin-top: auto; font-weight: 700; }
  @media (max-width: 29.99rem) {
    .team-card { flex-direction: row; align-items: flex-start; }
    .team-card__photo { flex: 0 0 6.5rem; }
    .team-card__photo :global(.team-photo--empty) { font-size: var(--step-1); }
    .team-card__body { padding: 0 0 0 var(--space-s); }
    .card-grid { gap: var(--space-m); }
    .team-card { background: none; box-shadow: none; padding-bottom: var(--space-m); border-bottom: 2px solid var(--mist); }
  }
</style>
