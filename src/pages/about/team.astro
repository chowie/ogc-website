---
import { getEntry } from 'astro:content';
import ContentPage from '../../layouts/ContentPage.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TeamPhoto from '../../components/TeamPhoto.astro';
import { getTeam, truncate } from '../../lib/content';

const entry = (await getEntry('pages', 'about/team'))!;
const team = await getTeam();
const groups = [
  { key: 'elders', title: 'Pastor and Elders', empty: 'Our pastor and elders will be listed here.' },
  { key: 'deacons', title: 'Deacons', intro: 'Our deacons care for the practical needs of the church family.', empty: 'Our deacons will be listed here.' },
  // Proposed positions (Chris, 2026-11-13): cards with no one named yet.
  { key: 'missions', title: 'Mission Board', intro: 'Proposed: four members who lead the church\'s support of its missionaries.', openings: 4, role: 'Mission Board Member' },
  { key: 'treasurer', title: 'Treasurer', intro: 'Proposed: keeps the church\'s financial records and reports to the church.', openings: 1, role: 'Treasurer' },
  { key: 'staff', title: 'Staff', empty: 'Our staff will be listed here.' },
] as const;
---

<ContentPage entry={entry}>
  {groups.map((g) => {
    const people = team.filter((m) => m.data.group === g.key);
    // Proposed groups keep a "To Be Named" card for each seat nobody fills yet.
    const seats = 'openings' in g ? Math.max(0, g.openings - people.length) : 0;
    const cards = [
      ...people.map((member) => ({ member, seat: 0 })),
      ...Array.from({ length: seats }, (_, i) => ({ member: undefined, seat: people.length + i + 1 })),
    ];
    return (
      <section class="team-group">
        <SectionHeading title={g.title} entry={entry} />
        {'intro' in g && <p class="team-group__intro">{g.intro}</p>}
        {cards.length > 0 ? (
          <ul class="card-grid team-grid">
            {cards.map(({ member: m, seat }) => (
              <li class="team-card">
                <div class="team-card__photo">{m ? <TeamPhoto member={m} width={480} /> : <TeamPhoto proposed />}</div>
                <div class="team-card__body">
                  {m ? (
                    <>
                      <h3 class="team-card__name">{m.data.name}</h3>
                      {m.data.role && <p class="team-card__role">{m.data.role}</p>}
                      {m.data.shortBio && <p class="team-card__bio">{truncate(m.data.shortBio)}</p>}
                      <a class="team-card__more" href={`/about/team/${m.id}`}>
                        Read More<span class="visually-hidden"> about {m.data.name}</span>
                      </a>
                    </>
                  ) : (
                    <>
                      <h3 class="team-card__name">To Be Named<span class="visually-hidden">: {g.title}, seat {seat} of {'openings' in g && g.openings}</span></h3>
                      {'role' in g && <p class="team-card__role">{g.role}</p>}
                    </>
                  )}
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="team-group__empty">{'empty' in g && g.empty}</p>
        )}
      </section>
    );
  })}
</ContentPage>

<style>
  .team-group + .team-group { margin-top: var(--space-l); }
  .team-group__empty { color: var(--muted); max-width: 40rem; }
  .team-group__intro { max-width: 40rem; margin-bottom: var(--space-m); }
  .team-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }
  .team-card { display: flex; flex-direction: column; background: #fff; box-shadow: 0 1px 0 var(--mist); }
  .team-card__body { padding: var(--space-m); display: flex; flex-direction: column; flex: 1; }
  .team-card__name { font-size: var(--step-1); margin-bottom: 0.25rem; overflow-wrap: normal; }
  .team-card__role { color: var(--coral-ink); font-weight: 600; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .team-card__bio { color: var(--muted); }
  .team-card__more { margin-top: auto; font-weight: 700; }
  @media (max-width: 29.99rem) {
    .team-card { flex-direction: row; align-items: flex-start; }
    .team-card__photo { flex: 0 0 6.5rem; }
    .team-card__photo :global(.team-photo--empty) { font-size: var(--step-1); }
    .team-card__body { padding: 0 0 0 var(--space-s); }
    .card-grid { gap: var(--space-m); }
    .team-card { background: none; box-shadow: none; padding-bottom: var(--space-m); border-bottom: 2px solid var(--mist); }
  }
</style>
